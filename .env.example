# Copy file này thành .env.local:  copy .env.example .env.local
# Khi deploy lên Vercel, khai báo các biến này trong Settings → Environment Variables

# Formspree - lối dự phòng nhận xác nhận tham dự khi chưa gắn Redis.
# 1. Đăng ký miễn phí tại https://formspree.io
# 2. Tạo form mới → lấy Form ID (ví dụ: xyzabc từ URL https://formspree.io/f/xyzabc)
NEXT_PUBLIC_FORMSPREE_ID=

# URL trang web - dùng cho ảnh xem trước khi chia sẻ link (Zalo, Facebook)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Upstash Redis: lưu sổ lưu bút, xác nhận tham dự và khách mời.
# Vercel → Storage → Upstash Redis → Connect: Vercel tự thêm KV_REST_API_*.
# Chạy trên máy: copy 2 giá trị đó vào .env.local.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Dùng chung database với thiệp khác thì đặt tiền tố riêng để không lẫn dữ liệu, ví dụ: sangnhung:
REDIS_KEY_PREFIX=

# Mật khẩu trang /quan-ly (xác nhận, khách mời, lời chúc)
GUESTBOOK_ADMIN_PASSWORD=
